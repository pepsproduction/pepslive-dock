          "ownerUid": {
            ".read": "auth !== null && data.val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())"
